{
	"expo": {
		"name": "PhysaFlow Calculator",
		"slug": "physaflow-calculator",
		"version": "1.0.2",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "physaflowcalculator",
		"userInterfaceStyle": "automatic",
		"ios": {
			"icon": "./assets/images/icon.png"
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/adaptive-icon.png",
				"backgroundColor": "#0F1F17"
			},
			"versionCode": 3,
			"predictiveBackGestureEnabled": false,
			"package": "com.s0726T31.PhysaFlowCalculator"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#0F1F17",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 160
				}
			],
			"expo-font",
			"expo-status-bar",
			"expo-sharing"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "c42873cd-2ee1-4e56-a411-4ac2d5fba1a7"
			}
		}
	}
}
