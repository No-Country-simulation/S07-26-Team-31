{
  "expo": {
    "name": "PhysaFlow Calculator",
    "slug": "physaflow-calculator",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "physaflowcalculator",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#121411"
      },
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "package": "com.s0726T31.PhysaFlowCalculator"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121411",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c42873cd-2ee1-4e56-a411-4ac2d5fba1a7"
      }
    }
  }
}
